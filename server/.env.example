# Environment
DATABASE_URL=postgresql://user:password@localhost:5432/overwatch
DATABASE_PROVIDER=postgresql
OPENAI_API_KEY=sk-...
MAPBOX_TOKEN=pk....

# LLM Model Tiers (GPT-5 family)
LLM_FLAGSHIP=gpt-5.4
LLM_MID_RANGE=gpt-5-mini
LLM_FAST=gpt-5-nano

# LLM Provider: "openai" (direct) or "asksage" (DoD-approved gateway)
# LLM_PROVIDER=asksage
# ASKSAGE_API_KEY=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# UDL Credentials
UDL_USERNAME=username
UDL_PASSWORD=password
